PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/lms_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME_generate_a_random_string_at_least_32_chars

# --- Mediasoup / WebRTC ---
# Listen on all interfaces (required for Docker, WSL, or multi-NIC hosts)
MEDIASOUP_LISTEN_IP=0.0.0.0
# IMPORTANT: Set this to the PUBLIC IP or domain of the server when deploying!
# - Local dev on same machine:  127.0.0.1
# - LAN testing from another device: LAN IP (e.g. 192.168.1.x)
# - Production server: public IP or domain that resolves to the server
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# UDP/TCP port range for media transports (each transport uses one port)
# Each peer needs 2 transports (send + recv), so for N users you need ~2N ports
# Make sure these ports are open in firewall/security group
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# --- CORS ---
# Comma-separated allowed origins for API and Socket.io
CORS_ORIGIN=http://localhost:5173
